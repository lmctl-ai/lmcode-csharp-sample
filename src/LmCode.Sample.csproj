<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <SampleVersion Condition="'$(SAMPLE_VERSION)' == ''">0.4.0</SampleVersion>
    <SampleVersion Condition="'$(SAMPLE_VERSION)' != ''">$(SAMPLE_VERSION)</SampleVersion>
    <InformationalVersion>$(SampleVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>lmcode-csharp-sample</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../vendor/lmcode-csharp/LmCode.csproj" />
    <!-- Embed the exact compiler schema bytes; discovery works from any directory. -->
    <EmbeddedResource Include="../sample-suite/sample.dsl.json" LogicalName="sample.schema" />
  </ItemGroup>
</Project>
