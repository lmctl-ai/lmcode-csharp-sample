import "../sample-suite/runner-lib.lms";
root = suite_root();
assert(len(ARGV) > 0, "host command required");
scratch = binary(root, {op:"temp"});
source = path_join(scratch, "note.lms");
bytecode = path_join(scratch, "note.dslb");
schema = path_join(root, "sample.dsl.json");
write_file(source, "program = _lmcode_ schema=" + json_stringify(schema) + ";\nledger.note(file_read(sample_tmp() + \"/note.bin\"));\nend _lmcode_\n");
compiled = invoke(root, ["node", path_join(root, "compile-fixture.mjs")], [source, bytecode], {}, 30000);
assert(compiled.code == 0 && compiled.stderr_hex == "", "note fixture compilation failed: " + compiled.stderr);
result = invoke(root, ARGV, ["--lmcode", bytecode], {"note.bin":"00080c090d0a225cffc3a9"}, 30000);
rmdir(scratch, true);
assert(result.code == 0 && result.stderr_hex == "" && result.hex == "", "note bytes differ");
println(result.hex);
